{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batch.photo/schemas/id-photo-jurisdictions.json",
  "type": "object",
  "required": ["schemaVersion", "listVersion", "standard", "source", "jurisdictions"],
  "properties": {
    "schemaVersion": {"type": "integer", "minimum": 1},
    "listVersion": {"type": "string", "minLength": 1},
    "standard": {"const": "ISO 3166-1 alpha-2"},
    "source": {
      "type": "object",
      "required": ["authority", "url", "reviewedAt"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "reviewedAt": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 249,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["code", "kind"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z]{2,16}$"},
          "kind": {"enum": ["country_or_area", "regional_group", "preset"]},
          "displayNameKey": {"type": "string", "pattern": "^region\\."},
          "memberCodes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z]{2}$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
