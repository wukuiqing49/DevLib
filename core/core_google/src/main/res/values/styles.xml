<resources>
    <style name="Gpay.Theme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gpay_accent</item>
        <item name="colorOnPrimary">@color/gpay_on_accent</item>
        <item name="android:windowBackground">@color/gpay_background</item>
        <item name="android:colorBackground">@color/gpay_background</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="Gpay.Theme.Sheet" parent="Gpay.Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="Gpay.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/gpay_text</item>
        <item name="android:breakStrategy">high_quality</item>
    </style>
    <style name="Gpay.Secondary" parent="Gpay.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/gpay_muted</item>
    </style>
    <style name="Gpay.Action" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="Gpay.TextAction" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
