<resources>
    <style name="Theme.LogReport" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/log_report_page_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="colorAccent">@color/log_report_page_accent</item>
        <item name="colorPrimary">@color/log_report_page_accent</item>
        <item name="colorControlActivated">@color/log_report_page_accent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="LogReportBody"><item name="android:textSize">14sp</item><item name="android:textColor">@color/log_report_page_text</item><item name="android:lineSpacingExtra">3dp</item></style>
    <style name="LogReportSecondary" parent="LogReportBody"><item name="android:textColor">@color/log_report_page_secondary</item></style>
    <style name="LogReportHeading" parent="LogReportBody"><item name="android:textSize">18sp</item><item name="android:textStyle">bold</item></style>
    <style name="LogReportAction" parent="Widget.AppCompat.Button.Borderless.Colored"><item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item><item name="android:textSize">14sp</item><item name="android:textColor">@color/log_report_page_accent</item></style>
    <style name="LogReportPrimaryAction" parent="LogReportAction"><item name="android:backgroundTint">@color/log_report_page_accent</item><item name="android:background">@drawable/log_report_page_primary</item><item name="android:textColor">@color/log_report_page_on_accent</item></style>
</resources>
