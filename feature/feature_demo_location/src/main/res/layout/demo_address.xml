<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
<LinearLayout style="@style/Demo.Page">
<TextView style="@style/Demo.Label" android:text="@string/address_intro" />
<com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:hint="@string/address_latitude"><com.google.android.material.textfield.TextInputEditText android:id="@+id/latitude" style="@style/Demo.Input" android:inputType="numberDecimal|numberSigned" android:saveEnabled="true" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:hint="@string/address_longitude"><com.google.android.material.textfield.TextInputEditText android:id="@+id/longitude" style="@style/Demo.Input" android:inputType="numberDecimal|numberSigned" android:saveEnabled="true" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/query" style="@style/Demo.Button.Primary" android:text="@string/address_query" />
<include android:id="@+id/result" layout="@layout/demo_output" />
</LinearLayout></ScrollView>
