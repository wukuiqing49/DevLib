<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Demo.Page" android:padding="0dp">
    <TextView style="@style/Demo.Heading" android:text="@string/demo_output" />
    <TextView android:id="@+id/inputs" style="@style/Demo.Label" android:textIsSelectable="true" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    <TextView android:id="@+id/message" style="@style/Demo.Label" android:textIsSelectable="true" />
    <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:maxHeight="360dp" android:contentDescription="@string/demo_preview" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/cancel" style="@style/Demo.Button" android:text="@string/demo_cancel" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/open" style="@style/Demo.Button" android:layout_width="0dp" android:layout_weight="1" android:text="@string/demo_open" />
        <com.google.android.material.button.MaterialButton android:id="@+id/share" style="@style/Demo.Button" android:layout_width="0dp" android:layout_weight="1" android:text="@string/demo_share" />
    </LinearLayout>
</LinearLayout>