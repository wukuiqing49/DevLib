<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Demo.Page" android:padding="16dp" android:layout_marginTop="24dp" android:background="@drawable/demo_result_surface">
    <TextView style="@style/Demo.Heading" android:layout_marginTop="0dp" android:text="@string/demo_output" />
    <TextView android:id="@+id/inputs" style="@style/Demo.Label" android:textIsSelectable="true" />
    <ImageView android:id="@+id/inputPreview" android:layout_width="match_parent" android:layout_height="200dp" android:scaleType="fitCenter" android:contentDescription="@string/workspace_original" android:visibility="gone" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    <TextView android:id="@+id/message" style="@style/Demo.Label" android:accessibilityLiveRegion="polite" android:textIsSelectable="true" />
    <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:maxHeight="360dp" android:contentDescription="@string/demo_preview" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/cancel" style="@style/Demo.Button.Danger" android:text="@string/demo_cancel" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/open" style="@style/Demo.Button.Primary" android:layout_marginEnd="4dp" android:layout_width="0dp" android:layout_weight="1" android:text="@string/demo_open" />
        <com.google.android.material.button.MaterialButton android:id="@+id/share" style="@style/Demo.Button" android:layout_marginStart="4dp" android:layout_width="0dp" android:layout_weight="1" android:text="@string/demo_share" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/save" style="@style/Demo.Button" android:text="@string/workspace_save" />
    <com.google.android.material.button.MaterialButton android:id="@+id/continueWith" style="@style/Demo.Button" android:text="@string/workspace_continue" />
</LinearLayout>