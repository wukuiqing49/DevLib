<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Demo.Page" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="Demo.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Demo.Heading" parent="Demo.Label">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>
    <style name="Demo.Button" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="Demo.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>