<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false">
    <LinearLayout style="@style/Demo.Page">
        <TextView style="@style/Demo.Label" android:text="@string/demo_watermark_intro" />
        <TextView style="@style/Demo.Heading" android:text="@string/demo_watermark_input" />
        <com.google.android.material.button.MaterialButton android:id="@+id/choose" style="@style/Demo.Button" android:text="@string/demo_choose" />
        <com.google.android.material.button.MaterialButton android:id="@+id/sample" style="@style/Demo.Button" android:text="@string/demo_sample" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_watermark_text">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/text" style="@style/Demo.Input" android:inputType="text" android:text="@string/demo_watermark_text_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_watermark_size">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/size" style="@style/Demo.Input" android:inputType="numberDecimal" android:text="@string/demo_watermark_size_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_watermark_alpha">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/alpha" style="@style/Demo.Input" android:inputType="number" android:text="@string/demo_watermark_alpha_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Demo.Heading" android:text="@string/demo_watermark_execute" />
        <com.google.android.material.button.MaterialButton android:id="@+id/render" style="@style/Demo.Button" android:text="@string/demo_watermark_render" />
        <include android:id="@+id/result" layout="@layout/demo_output" />
    </LinearLayout>
</ScrollView>