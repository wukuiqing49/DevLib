<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false">
    <LinearLayout style="@style/Demo.Page">
        <TextView style="@style/Demo.Label" android:text="@string/demo_qr_intro" />
        <TextView style="@style/Demo.Heading" android:text="@string/demo_qr_input" />
        <com.google.android.material.button.MaterialButton android:id="@+id/choose" style="@style/Demo.Button" android:text="@string/demo_choose" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_qr_content">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/content" style="@style/Demo.Input" android:inputType="text" android:text="@string/demo_qr_content_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_qr_size">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/size" style="@style/Demo.Input" android:inputType="number" android:text="@string/demo_qr_size_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_qr_color">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/color" style="@style/Demo.Input" android:inputType="text" android:text="@string/demo_qr_color_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Demo.Heading" android:text="@string/demo_qr_execute" />
        <com.google.android.material.button.MaterialButton android:id="@+id/generate" style="@style/Demo.Button" android:text="@string/demo_qr_generate" />
        <com.google.android.material.button.MaterialButton android:id="@+id/recognize" style="@style/Demo.Button" android:text="@string/demo_qr_recognize" />
        <include android:id="@+id/result" layout="@layout/demo_output" />
    </LinearLayout>
</ScrollView>