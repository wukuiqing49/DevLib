<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false">
    <LinearLayout style="@style/Demo.Page">
        <TextView style="@style/Demo.Label" android:text="@string/demo_upload_intro" />
        <TextView style="@style/Demo.Heading" android:text="@string/demo_upload_input" />
        <com.google.android.material.button.MaterialButton android:id="@+id/choose" style="@style/Demo.Button" android:text="@string/demo_choose" />
        <TextView style="@style/Demo.Label" android:text="@string/demo_upload_protocol" />
        <Spinner android:id="@+id/protocol" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:id="@+id/protocolHelp" style="@style/Demo.Label" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_upload_host">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/host" style="@style/Demo.Input" android:inputType="text" android:text="@string/demo_upload_host_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_upload_port">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/port" style="@style/Demo.Input" android:inputType="number" android:text="@string/demo_upload_port_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_upload_user">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/user" style="@style/Demo.Input" android:inputType="text" android:text="@string/demo_upload_user_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_upload_password">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/password" style="@style/Demo.Input" android:inputType="textPassword" android:text="@string/demo_upload_password_value" android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_upload_directory">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/directory" style="@style/Demo.Input" android:inputType="text" android:text="@string/demo_upload_directory_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Demo.Heading" android:text="@string/demo_upload_execute" />
        <com.google.android.material.button.MaterialButton android:id="@+id/test" style="@style/Demo.Button" android:text="@string/demo_upload_test" />
        <com.google.android.material.button.MaterialButton android:id="@+id/upload" style="@style/Demo.Button.Primary" android:text="@string/demo_upload_upload" />
        <include android:id="@+id/result" layout="@layout/demo_output" />
    </LinearLayout>
</ScrollView>