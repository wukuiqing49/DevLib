<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none"><LinearLayout style="@style/Demo.Page">
<TextView style="@style/Demo.Label" android:text="@string/usb_intro" />
<TextView android:id="@+id/tree" style="@style/Demo.Label" android:text="@string/storage_no_tree" />
<com.google.android.material.button.MaterialButton android:id="@+id/authorize" style="@style/Demo.Button.Primary" android:text="@string/usb_authorize" />
<com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/storage_path"><com.google.android.material.textfield.TextInputEditText android:id="@+id/path" style="@style/Demo.Input" android:inputType="text" android:saveEnabled="true" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/browse" style="@style/Demo.Button" android:text="@string/storage_browse" />
<com.google.android.material.button.MaterialButton android:id="@+id/up" style="@style/Demo.Button" android:text="@string/storage_up" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/entries" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:scrollbars="none" />
<com.google.android.material.button.MaterialButton android:id="@+id/choose" style="@style/Demo.Button" android:text="@string/demo_choose" />
<com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/storage_filename"><com.google.android.material.textfield.TextInputEditText android:id="@+id/filename" style="@style/Demo.Input" android:inputType="text" android:saveEnabled="true" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/upload" style="@style/Demo.Button.Primary" android:text="@string/storage_upload" />
<com.google.android.material.button.MaterialButton android:id="@+id/probe" style="@style/Demo.Button" android:text="@string/storage_probe" />
<include android:id="@+id/result" layout="@layout/demo_output" />
</LinearLayout></ScrollView>
