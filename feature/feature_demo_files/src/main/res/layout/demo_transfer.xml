<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false">
    <LinearLayout style="@style/Demo.Page">
        <TextView style="@style/Demo.Label" android:text="@string/demo_transfer_intro" />
        <TextView style="@style/Demo.Heading" android:text="@string/demo_transfer_input" />
        <com.google.android.material.button.MaterialButton android:id="@+id/choose" style="@style/Demo.Button" android:text="@string/demo_choose" />
        <com.google.android.material.button.MaterialButton android:id="@+id/sample" style="@style/Demo.Button" android:text="@string/demo_sample" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_transfer_name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/name" style="@style/Demo.Input" android:inputType="text" android:text="@string/demo_transfer_name_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Demo.Heading" android:text="@string/demo_transfer_destination" />
        <Spinner android:id="@+id/protocol" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <LinearLayout android:id="@+id/remote" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/Demo.Label" android:text="@string/demo_transfer_remote_notice" />
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_transfer_root"><com.google.android.material.textfield.TextInputEditText android:id="@+id/rootUrl" style="@style/Demo.Input" android:inputType="textNoSuggestions" android:saveEnabled="true" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_transfer_user"><com.google.android.material.textfield.TextInputEditText android:id="@+id/user" style="@style/Demo.Input" android:inputType="textNoSuggestions" android:saveEnabled="true" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_transfer_password"><com.google.android.material.textfield.TextInputEditText android:id="@+id/password" style="@style/Demo.Input" android:inputType="textPassword" android:saveEnabled="false" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_transfer_host_key"><com.google.android.material.textfield.TextInputEditText android:id="@+id/hostKey" style="@style/Demo.Input" android:inputType="textNoSuggestions" android:saveEnabled="true" /></com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/testConnection" style="@style/Demo.Button" android:text="@string/demo_transfer_test" />
        <TextView style="@style/Demo.Heading" android:text="@string/demo_transfer_execute" />
        <com.google.android.material.button.MaterialButton android:id="@+id/enqueue" style="@style/Demo.Button" android:text="@string/demo_transfer_enqueue" />
        <com.google.android.material.button.MaterialButton android:id="@+id/refresh" style="@style/Demo.Button" android:text="@string/demo_transfer_refresh" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pause" style="@style/Demo.Button" android:text="@string/demo_transfer_pause" />
        <com.google.android.material.button.MaterialButton android:id="@+id/resume" style="@style/Demo.Button" android:text="@string/demo_transfer_resume" />
        <com.google.android.material.button.MaterialButton android:id="@+id/canceljob" style="@style/Demo.Button" android:text="@string/demo_transfer_canceljob" />
        <TextView style="@style/Demo.Heading" android:text="@string/demo_transfer_history" />
        <TextView android:id="@+id/taskStatus" style="@style/Demo.Label" android:accessibilityLiveRegion="polite" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/tasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:scrollbars="none" android:clipToPadding="false" />
        <include android:id="@+id/result" layout="@layout/demo_output" />
    </LinearLayout>
</ScrollView>