<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none"><LinearLayout style="@style/Demo.Page">
<TextView style="@style/Demo.Label" android:text="@string/nas_intro" />
<Spinner android:id="@+id/protocol" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
<com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nas_root"><com.google.android.material.textfield.TextInputEditText android:id="@+id/endpoint" style="@style/Demo.Input" android:inputType="textUri" android:saveEnabled="false" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nas_username"><com.google.android.material.textfield.TextInputEditText android:id="@+id/username" style="@style/Demo.Input" android:inputType="text" android:saveEnabled="false" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nas_password"><com.google.android.material.textfield.TextInputEditText android:id="@+id/password" style="@style/Demo.Input" android:inputType="textPassword" android:saveEnabled="false" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nas_fingerprint"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fingerprint" style="@style/Demo.Input" android:inputType="text" android:saveEnabled="false" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/discover" style="@style/Demo.Button" android:text="@string/nas_discover" />
<com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/storage_path"><com.google.android.material.textfield.TextInputEditText android:id="@+id/path" style="@style/Demo.Input" android:inputType="text" android:saveEnabled="true" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/connect" style="@style/Demo.Button.Primary" android:text="@string/storage_connect" />
<com.google.android.material.button.MaterialButton android:id="@+id/up" style="@style/Demo.Button" android:text="@string/storage_up" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/entries" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:scrollbars="none" />
<com.google.android.material.button.MaterialButton android:id="@+id/choose" style="@style/Demo.Button" android:text="@string/demo_choose" />
<com.google.android.material.textfield.TextInputLayout style="@style/Demo.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/storage_filename"><com.google.android.material.textfield.TextInputEditText android:id="@+id/filename" style="@style/Demo.Input" android:inputType="text" android:saveEnabled="true" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/upload" style="@style/Demo.Button.Primary" android:text="@string/storage_upload" />
<com.google.android.material.button.MaterialButton android:id="@+id/probe" style="@style/Demo.Button" android:text="@string/storage_probe" />
<include android:id="@+id/result" layout="@layout/demo_output" />
</LinearLayout></ScrollView>
