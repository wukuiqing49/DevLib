<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false">
    <LinearLayout style="@style/Demo.Page">
        <TextView style="@style/Demo.Label" android:text="@string/demo_drop_intro" />
        <TextView style="@style/Demo.Heading" android:text="@string/demo_drop_input" />
        <com.google.android.material.button.MaterialButton android:id="@+id/choose" style="@style/Demo.Button" android:text="@string/demo_choose" />
        <com.google.android.material.button.MaterialButton android:id="@+id/sample" style="@style/Demo.Button" android:text="@string/demo_sample" />
        <TextView style="@style/Demo.Heading" android:text="@string/demo_drop_execute" />
        <com.google.android.material.button.MaterialButton android:id="@+id/start" style="@style/Demo.Button" android:text="@string/demo_drop_start" />
        <com.google.android.material.button.MaterialButton android:id="@+id/approve" style="@style/Demo.Button" android:text="@string/demo_drop_approve" />
        <com.google.android.material.button.MaterialButton android:id="@+id/reject" style="@style/Demo.Button" android:text="@string/demo_drop_reject" />
        <com.google.android.material.button.MaterialButton android:id="@+id/stop" style="@style/Demo.Button" android:text="@string/demo_drop_stop" />
        <include android:id="@+id/result" layout="@layout/demo_output" />
    </LinearLayout>
</ScrollView>