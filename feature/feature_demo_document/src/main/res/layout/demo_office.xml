<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false">
    <LinearLayout style="@style/Demo.Page">
        <TextView style="@style/Demo.Label" android:text="@string/demo_office_intro" />
        <TextView style="@style/Demo.Heading" android:text="@string/demo_office_input" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_office_title">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/title" style="@style/Demo.Input" android:inputType="text" android:text="@string/demo_office_title_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_office_body">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/body" style="@style/Demo.Input" android:inputType="textMultiLine" android:text="@string/demo_office_body_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_office_rows">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/rows" style="@style/Demo.Input" android:inputType="textMultiLine" android:text="@string/demo_office_rows_value" android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Demo.Heading" android:text="@string/demo_office_execute" />
        <com.google.android.material.button.MaterialButton android:id="@+id/word" style="@style/Demo.Button" android:text="@string/demo_office_word" />
        <com.google.android.material.button.MaterialButton android:id="@+id/excel" style="@style/Demo.Button" android:text="@string/demo_office_excel" />
        <include android:id="@+id/result" layout="@layout/demo_output" />
    </LinearLayout>
</ScrollView>