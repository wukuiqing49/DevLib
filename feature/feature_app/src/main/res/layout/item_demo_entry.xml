<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/dev_surface_card" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/dev_outline_variant">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="@color/dev_secondary" />
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceTitleLarge" android:accessibilityHeading="true" />
        <TextView android:id="@+id/description" style="@style/Demo.Label" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/primary" style="@style/Demo.Button.Primary" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="4dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/secondary" style="@style/Demo.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/select" style="@style/Demo.Button" android:text="@string/workbench_select" android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
