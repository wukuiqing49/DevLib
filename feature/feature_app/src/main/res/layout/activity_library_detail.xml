<TextView android:id="@+id/requirement" style="@style/Demo.Label" android:textColor="@color/dev_secondary" />
<TextView android:id="@+id/routerHeading" style="@style/Demo.Heading" android:text="@string/integration_router_modules" />
<com.google.android.material.chip.ChipGroup android:id="@+id/routerModules" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" />
